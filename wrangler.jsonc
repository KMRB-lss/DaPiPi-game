{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dapipi-game",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "single_page_application",
    "exclude": [".git", ".wrangler", ".gitignore", "LICENSE", "*.md"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}